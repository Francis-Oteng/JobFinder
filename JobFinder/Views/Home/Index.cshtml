@{
    ViewBag.Title = "JobFinder | Intelligent Job Matching Platform";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- ========================= SLIDER CONTAINER ========================= -->
<div id="jobFinderSlider" class="slider-container">

    <!-- ========================= SLIDE 1: HERO / WELCOME ========================= -->
