</div>


<!-- ========================= SLIDER NAVIGATION DOTS ========================= -->

<div class="slider-dots text-center">

    <span class="dot active" data-index="0"></span>

    <span class="dot" data-index="1"></span>

    <span class="dot" data-index="2"></span>

    <span class="dot" data-index="3"></span>

    <span class="dot" data-index="4"></span>

    <span class="dot" data-index="5"></span>

</div>


<!-- ========================= PREVIOUS BUTTON ========================= -->

<button class="slider-nav prev"
        type="button"
        onclick="navigateSlide(-1)"
        aria-label="Previous slide">

    <i class="fa-solid fa-chevron-left"></i>

</button>


<!-- ========================= NEXT BUTTON ========================= -->

<button class="slider-nav next"
        type="button"
        onclick="navigateSlide(1)"
        aria-label="Next slide">

    <i class="fa-solid fa-chevron-right"></i>

</button>


@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const slides = document.querySelectorAll(".slide");
            const dots = document.querySelectorAll(".dot");

            let current = 0;
            let autoPlayInterval;


            // ==========================================
            // SHOW SLIDE
            // ==========================================

            function showSlide(index) {

                if (index < 0) {
                    index = slides.length - 1;
                }

                if (index >= slides.length) {
                    index = 0;
                }


                slides.forEach(function (slide, i) {

                    slide.style.transform =
                        `translateX(${(i - index) * 100}%)`;

                });


                dots.forEach(function (dot) {

                    dot.classList.remove("active");

                });


                if (dots[index]) {

                    dots[index].classList.add("active");

                }


                current = index;

            }


            // ==========================================
            // NAVIGATE SLIDE
            // ==========================================

            window.navigateSlide = function (direction) {

                showSlide(current + direction);

                resetAutoPlay();

            };


            // ==========================================
            // AUTO PLAY
            // ==========================================

            function resetAutoPlay() {

                clearInterval(autoPlayInterval);

                autoPlayInterval = setInterval(function () {

                    showSlide((current + 1) % slides.length);

                }, 8000);

            }


            // ==========================================
            // DOT NAVIGATION
            // ==========================================

            dots.forEach(function (dot) {

                dot.addEventListener("click", function () {

                    const index = parseInt(
                        dot.getAttribute("data-index")
                    );

                    showSlide(index);

                    resetAutoPlay();

                });

            });


            // ==========================================
            // KEYBOARD NAVIGATION
            // ==========================================

            document.addEventListener("keydown", function (event) {

                if (event.key === "ArrowLeft") {

                    navigateSlide(-1);

                }

                if (event.key === "ArrowRight") {

                    navigateSlide(1);

                }

            });


            // ==========================================
            // TOUCH SWIPE
            // ==========================================

            let touchStartX = 0;
            let touchEndX = 0;

            const slider = document.querySelector(".slider-container");


            if (slider) {

                slider.addEventListener("touchstart", function (event) {

                    touchStartX =
                        event.changedTouches[0].screenX;

                });


                slider.addEventListener("touchend", function (event) {

                    touchEndX =
                        event.changedTouches[0].screenX;


                    if (touchStartX - touchEndX > 50) {

                        navigateSlide(1);

                    }


                    if (touchEndX - touchStartX > 50) {

                        navigateSlide(-1);

                    }

                });

            }


            // ==========================================
            // HOVER EFFECT
            // ==========================================

            document.querySelectorAll(".hover-lift").forEach(function (card) {

                card.addEventListener("mouseenter", function () {

                    this.style.transform = "translateY(-10px)";

                });


                card.addEventListener("mouseleave", function () {

                    this.style.transform = "translateY(0)";

                });

            });


            // ==========================================
            // PROCESS CARD ANIMATION
            // ==========================================

            const observerOptions = {

                threshold: 0.3,

                rootMargin: "0px"

            };


            const observer = new IntersectionObserver(
                function (entries) {

                    entries.forEach(function (entry) {

                        if (entry.isIntersecting) {

                            entry.target.style.opacity = "1";

                            entry.target.style.transform =
                                "translateY(0)";

                        }

                    });

                },
                observerOptions
            );


            document.querySelectorAll(".process-card").forEach(function (card) {

                card.style.opacity = "0";

                card.style.transform = "translateY(30px)";

                card.style.transition =
                    "all 0.6s ease";

                observer.observe(card);

            });


            // ==========================================
            // INITIALIZE SLIDER
            // ==========================================

            showSlide(current);

            resetAutoPlay();

        });

    </script>


    <style>

        /* ==========================================
           SLIDER
           ========================================== */

        .slider-container {

            position: relative;

            width: 100%;

            height: 100vh;

            overflow: hidden;

        }


        .slide {

            position: absolute;

            width: 100%;

            height: 100vh;

            top: 0;

            left: 0;

            transition: transform 1s ease-in-out;

            display: flex;

            justify-content: center;

            align-items: center;

            padding: 2rem;

            overflow: hidden;

        }


        .hero-slide {

            background: linear-gradient(
                135deg,
                #2563eb,
                #22c1c3
            );

        }


        /* ==========================================
           TEXT
           ========================================== */

        .text-accent {

            color: #ffeb3b;

        }


        .text-purple {

            color: #6610f2;

        }


        /* ==========================================
           SLIDER DOTS
           ========================================== */

        .slider-dots {

            position: fixed;

            bottom: 20px;

            left: 0;

            right: 0;

            text-align: center;

            z-index: 100;

        }


        .dot {

            display: inline-block;

            width: 14px;

            height: 14px;

            margin: 0 6px;

            background-color: rgba(255, 255, 255, 0.5);

            border: 2px solid rgba(37, 99, 235, 0.3);

            border-radius: 50%;

            cursor: pointer;

            transition: all 0.3s ease;

        }


        .dot.active {

            background-color: #2563eb;

            transform: scale(1.3);

            border-color: #2563eb;

        }


        .dot:hover {

            background-color: #2563eb;

            transform: scale(1.2);

        }


        /* ==========================================
           NAVIGATION ARROWS
           ========================================== */

        .slider-nav {

            position: fixed;

            top: 50%;

            transform: translateY(-50%);

            background: rgba(37, 99, 235, 0.8);

            color: white;

            border: none;

            width: 50px;

            height: 50px;

            border-radius: 50%;

            cursor: pointer;

            z-index: 100;

            display: flex;

            align-items: center;

            justify-content: center;

            transition: all 0.3s ease;

            font-size: 1.2rem;

        }


        .slider-nav:hover {

            background: rgba(37, 99, 235, 1);

            transform: translateY(-50%) scale(1.1);

        }


        .slider-nav.prev {

            left: 20px;

        }


        .slider-nav.next {

            right: 20px;

        }


        /* ==========================================
           HOVER CARDS
           ========================================== */

        .hover-lift {

            transition: all 0.3s ease;

            cursor: pointer;

        }


        .hover-lift:hover {

            transform: translateY(-10px);

            box-shadow:
                0 10px 30px rgba(0, 0, 0, 0.2) !important;

        }


        /* ==========================================
           PROCESS CARDS
           ========================================== */

        .process-card {

            transition: all 0.6s ease;

        }


        .process-card:hover {

            transform: scale(1.05);

            box-shadow:
                0 8px 25px rgba(37, 99, 235, 0.2);

        }


        .process-number {

            transition: all 0.3s ease;

        }


        .process-card:hover .process-number {

            transform: rotate(360deg);

        }


        /* ==========================================
           BUTTONS
           ========================================== */

        .btn {

            border-radius: 8px;

            padding: 10px 20px;

            transition: all 0.3s ease;

        }


        .btn:hover {

            transform: translateY(-2px);

            box-shadow:
                0 5px 15px rgba(0, 0, 0, 0.2);

        }


        /* ==========================================
           ANIMATIONS
           ========================================== */

        .animate-fade {

            opacity: 0;

            transform: translateY(20px);

            animation:
                fadeInUp 1.2s ease forwards;

        }


        @@keyframes fadeInUp {

            from {

                opacity: 0;

                transform: translateY(20px);

            }

            to {

                opacity: 1;

                transform: translateY(0);

            }

        }


        /* ==========================================
           RESPONSIVE DESIGN
           ========================================== */

        @@media (max-width: 768px) {

            .slider-nav {

                width: 40px;

                height: 40px;

                font-size: 1rem;

            }


            .slider-nav.prev {

                left: 10px;

            }


            .slider-nav.next {

                right: 10px;

            }


            .slide {

                padding: 1rem;

            }


            .display-3 {

                font-size: 2rem !important;

            }

        }

    </style>

}