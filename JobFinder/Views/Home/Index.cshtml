                    <div class="card border-0 shadow-sm p-4 text-center h-100 hover-lift">

                        <i class="fa-solid fa-rocket fa-3x text-danger mb-3"></i>

                        <h5 class="fw-bold">
                            Scalable
                        </h5>

                        <p class="text-muted">
                            Designed to support growing numbers of jobs,
                            applicants, and matching operations.
                        </p>

                    </div>

                </div>


                <!-- USER FRIENDLY -->
                <div class="col-md-4">

                    <div class="card border-0 shadow-sm p-4 text-center h-100 hover-lift">

