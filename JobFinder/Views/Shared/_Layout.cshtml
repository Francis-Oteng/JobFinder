
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - JobFinder</title>

    <script type="importmap"></script>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Application CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/JobFinder.styles.css" asp-append-version="true" />

    <!-- FontAwesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
          integrity="sha512-0vK1F5nMObJ4xZPnHskT1bOIH6dCHcFfQFjE3P9Kq6e0IexP/j1qpQhkoyZNEqfSPKkuPsvfOykxN5aXGyv0rQ=="
          crossorigin="anonymous"
          referrerpolicy="no-referrer" />
</head>

<body>

    <!-- =========================================================
         MAIN APPLICATION NAVBAR
         ========================================================= -->

    <header>

        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">

            <div class="container-fluid">

                <!-- JobFinder Logo -->
                <a class="navbar-brand fw-bold"
                   asp-controller="Home"
                   asp-action="Index">
                    JobFinder
                </a>


                <!-- Mobile Navbar Button -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <div id="mainNavbar"
                     class="navbar-collapse collapse">


                    <!-- =================================================
                         LEFT SIDE NAVIGATION
                         ================================================= -->

                    <ul class="navbar-nav me-auto">


                        <!-- =========================
                             PUBLIC MENU
                             ========================= -->

                      


                        <!-- =================================================
                             GUEST MENU
                             Only visible when NOT logged in
                             ================================================= -->

                        @if (User.Identity?.IsAuthenticated != true)
                        {
                              <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">

                                <i class="fa-solid fa-house me-1"></i>
                                Home

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Privacy">

                                Privacy

                            </a>

                        </li>


                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Account"
                                   asp-action="Login">

                                    Login

                                </a>

                            </li>


                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Account"
                                   asp-action="Register">

                                    Register

                                </a>

                            </li>

                        }


                        <!-- =================================================
                             APPLICANT MENU
                             ================================================= -->

                        @if (User.Identity?.IsAuthenticated == true &&
                             User.IsInRole("Applicant"))
                        {

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Applicant"
                                   asp-action="Dashboard">

                                    <i class="fa-solid fa-chart-line me-1"></i>
                                    Dashboard

                                </a>

                            </li>


                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Applicant"
                                   asp-action="Jobs">

                                    <i class="fa-solid fa-magnifying-glass me-1"></i>
                                    Find Jobs

                                </a>

                            </li>


                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Applicant"
                                   asp-action="Applications">

                                    <i class="fa-solid fa-file-lines me-1"></i>
                                    My Applications

                                </a>

                            </li>


                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Applicant"
                                   asp-action="SavedJobs">

                                    <i class="fa-solid fa-bookmark me-1"></i>
                                    Saved Jobs

                                </a>

                            </li>

                        }


                        <!-- =================================================
                             EMPLOYER MENU
                             ================================================= -->

                        @if (User.Identity?.IsAuthenticated == true &&
                             User.IsInRole("Employer"))
                        {

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Employer"
                                   asp-action="Dashboard">

                                    <i class="fa-solid fa-chart-line me-1"></i>
                                    Dashboard

                                </a>

                            </li>


                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Employer"
                                   asp-action="Jobs">

                                    <i class="fa-solid fa-briefcase me-1"></i>
                                    My Jobs

                                </a>

                            </li>


                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Employer"
                                   asp-action="PostJob">

                                    <i class="fa-solid fa-plus me-1"></i>
                                    Post a Job

                                </a>

                            </li>


                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Employer"
                                   asp-action="Applicants">

                                    <i class="fa-solid fa-users me-1"></i>
                                    Applicants

                                </a>

                            </li>

                        }


                        <!-- =================================================
                             ADMIN MENU
                             ================================================= -->

                        @if (User.Identity?.IsAuthenticated == true &&
                             User.IsInRole("Admin"))
                        {

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Admin"
                                   asp-action="Dashboard">

                                    <i class="fa-solid fa-shield-halved me-1"></i>
                                    Admin Dashboard

                                </a>

                            </li>

                        }

                    </ul>


                    <!-- =================================================
                         RIGHT SIDE USER MENU
                         ================================================= -->

                    @if (User.Identity?.IsAuthenticated == true)
                    {

                        <ul class="navbar-nav">


                            <!-- User Name -->

                            <li class="nav-item">

                                <span class="nav-link text-muted">

                                    <i class="fa-solid fa-user me-1"></i>

                                    Hello, @User.Identity.Name

                                </span>

                            </li>


                            <!-- Logout -->

                            <li class="nav-item">

                                <form asp-controller="Account"
                                      asp-action="Logout"
                                      method="post"
                                      class="d-inline">

                                    <button type="submit"
                                            class="nav-link btn btn-link">

                                        <i class="fa-solid fa-right-from-bracket me-1"></i>
                                        Logout

                                    </button>

                                </form>

                            </li>

                        </ul>

                    }

                </div>

            </div>

        </nav>

    </header>


    <!-- =========================================================
         MAIN CONTENT
         ========================================================= -->

    <div class="container">

        <main role="main" class="pb-3">

            @RenderBody()

        </main>

    </div>


    <!-- =========================================================
         FOOTER
         ========================================================= -->

    <footer class="border-top footer text-muted py-3 mt-5">

        <div class="container text-center">

            &copy; 2026 - <strong>JobFinder</strong>

            <span class="mx-2">|</span>

            <a asp-controller="Home"
               asp-action="Privacy"
               class="text-decoration-none text-secondary">

                Privacy

            </a>

            <span class="mx-2">|</span>

            <a asp-controller="Home"
               asp-action="Help"
               class="text-decoration-none text-secondary">

                Help Centre

            </a>

        </div>

    </footer>


    <!-- =========================================================
         SCRIPTS
         ========================================================= -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>

