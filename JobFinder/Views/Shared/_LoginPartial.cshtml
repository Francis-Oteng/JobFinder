@using Microsoft.AspNetCore.Identity
@using JobFinder.Models
@using static JobFinder.Models.Enums
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav ms-auto">
    @if (SignInManager.IsSignedIn(Context.User))
    {
        var role = Context.User.IsInRole(nameof(UserRole.Employer)) ? UserRole.Employer : UserRole.Applicant;
        var dashboardController = role == UserRole.Employer ? "Employer" : "Applicant";

        <li class="nav-item">
            <a class="nav-link" asp-controller="@dashboardController" asp-action="Dashboard">Dashboard</a>
        </li>
        <li class="nav-item">
            <span class="nav-link text-muted">Hi, @Context.User.Identity?.Name</span>
        </li>
        <li class="nav-item">
            <form class="form-inline" asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="btn btn-link nav-link">Log out</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link" asp-controller="Account" asp-action="Login">Log in</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-controller="Account" asp-action="Register">Register</a>
        </li>
    }
</ul>