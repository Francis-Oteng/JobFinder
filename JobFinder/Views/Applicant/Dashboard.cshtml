@model JobFinder.Models.ViewModels.ApplicantDashboardViewModel

@{
    ViewData["Title"] = "Applicant Dashboard";
}

<!-- =========================================================
     HEADER + PROFILE ACTION
========================================================== -->

<div class="row g-3 mb-4">


<!-- WELCOME -->
<div class="col-12 col-lg-8">
    <div class="h-100">
        <h2 class="fw-bold mb-1">
            Welcome back, @Model.FullName
        </h2>

        <p class="text-muted mb-0">
            Find opportunities that match your skills and career goals.
        </p>
    </div>
</div>

<!-- EDIT / COMPLETE PROFILE -->
<div class="col-12 col-lg-4">
    <div class="d-flex justify-content-lg-end align-items-center h-100">

        @if (!Model.ProfileComplete)
        {
            <a asp-controller="Applicant"
               asp-action="EditProfile"
               class="btn btn-warning">

                <i class="fa-solid fa-user-pen me-2"></i>
                EditProfile/Complete Profile

            </a>
        }
        else
        {
            <a asp-controller="Applicant"
               asp-action="EditProfile"
               class="btn btn-outline-primary">

                <i class="fa-solid fa-user-pen me-2"></i>
                Edit Profile

            </a>
        }

    </div>
</div>


</div>


    <!-- =========================================================
         QUICK ACTIONS
    ========================================================== -->

    <div class="row g-3 mb-4">

        <!-- Available Jobs -->

        <div class="col-12 col-md-4">

            <a asp-controller="Applicant"
               asp-action="Jobs"
               class="text-decoration-none">

                <div class="card shadow-sm h-100
                            border-0 dashboard-action-card">

                    <div class="card-body">

                        <div class="d-flex
                                    justify-content-between
                                    align-items-center">

                            <div>

                                <h5 class="fw-bold text-dark mb-1">
                                    Find Jobs
                                </h5>

                                <p class="text-muted small mb-0">
                                    Browse available job opportunities.
                                </p>

                            </div>

                            <div class="fs-2 text-primary">
                                <i class="fa-solid fa-briefcase"></i>
                            </div>

                        </div>

                    </div>

                </div>

            </a>

        </div>


        <!-- My Applications -->

        <div class="col-12 col-md-4">

            <a asp-controller="Applicant"
               asp-action="Applications"
               class="text-decoration-none">

                <div class="card shadow-sm h-100
                            border-0 dashboard-action-card">

                    <div class="card-body">

                        <div class="d-flex
                                    justify-content-between
                                    align-items-center">

                            <div>

                                <h5 class="fw-bold text-dark mb-1">
                                    My Applications
                                </h5>

                                <p class="text-muted small mb-0">
                                    Track jobs you have applied for.
                                </p>

                            </div>

                            <div class="fs-2 text-success">
                                <i class="fa-solid fa-file-lines"></i>
                            </div>

                        </div>

                    </div>

                </div>

            </a>

        </div>


        <!-- Saved Jobs -->

        <div class="col-12 col-md-4">

            <a asp-controller="Applicant"
               asp-action="SavedJobs"
               class="text-decoration-none">

                <div class="card shadow-sm h-100
                            border-0 dashboard-action-card">

                    <div class="card-body">

                        <div class="d-flex
                                    justify-content-between
                                    align-items-center">

                            <div>

                                <h5 class="fw-bold text-dark mb-1">
                                    Saved Jobs
                                </h5>

                                <p class="text-muted small mb-0">
                                    View jobs you saved for later.
                                </p>

                            </div>

                            <div class="fs-2 text-warning">
                                <i class="fa-solid fa-bookmark"></i>
                            </div>

                        </div>

                    </div>

                </div>

            </a>

        </div>

    </div>


    <!-- =========================================================
         STATISTICS
    ========================================================== -->

    <div class="row g-3 mb-4">

        <!-- Applications -->

        <div class="col-6 col-md-3">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex
                                justify-content-between
                                align-items-center">

                        <div>

                            <div class="text-muted small">
                                Applications
                            </div>

                            <div class="fs-3 fw-bold">
                                @Model.ApplicationsCount
                            </div>

                        </div>

                        <div class="text-primary fs-3">
                            <i class="fa-solid fa-paper-plane"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Shortlisted -->

        <div class="col-6 col-md-3">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex
                                justify-content-between
                                align-items-center">

                        <div>

                            <div class="text-muted small">
                                Shortlisted
                            </div>

                            <div class="fs-3 fw-bold">
                                @Model.ShortlistedCount
                            </div>

                        </div>

                        <div class="text-success fs-3">
                            <i class="fa-solid fa-star"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Interviews -->

        <div class="col-6 col-md-3">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex
                                justify-content-between
                                align-items-center">

                        <div>

                            <div class="text-muted small">
                                Interviews
                            </div>

                            <div class="fs-3 fw-bold">
                                @Model.InterviewCount
                            </div>

                        </div>

                        <div class="text-info fs-3">
                            <i class="fa-solid fa-calendar-check"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Saved Jobs -->

        <div class="col-6 col-md-3">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex
                                justify-content-between
                                align-items-center">

                        <div>

                            <div class="text-muted small">
                                Saved Jobs
                            </div>

                            <div class="fs-3 fw-bold">
                                @Model.SavedJobsCount
                            </div>

                        </div>

                        <div class="text-warning fs-3">
                            <i class="fa-solid fa-bookmark"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         RECENT APPLICATIONS
    ========================================================== -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white
                    d-flex justify-content-between
                    align-items-center">

            <h5 class="mb-0 fw-bold">
                Recent Applications
            </h5>

            <a asp-controller="Applicant"
               asp-action="Applications"
               class="small text-decoration-none">

                View All

                <i class="fa-solid fa-arrow-right ms-1"></i>

            </a>

        </div>


        <div class="card-body p-0">

            @if (Model.RecentApplications == null ||
                 !Model.RecentApplications.Any())
            {
                <div class="text-center p-5">

                    <div class="fs-1 text-muted mb-3">
                        <i class="fa-regular fa-folder-open"></i>
                    </div>

                    <h6 class="fw-bold">
                        No applications yet
                    </h6>

                    <p class="text-muted small">
                        Start exploring available jobs and apply
                        for opportunities that interest you.
                    </p>

                    <a asp-controller="Applicant"
                       asp-action="Jobs"
                       class="btn btn-primary">

                        <i class="fa-solid fa-magnifying-glass me-2"></i>
                        Find Jobs
                    </a>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover
                                  align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th>Job</th>

                                <th>Company</th>

                                <th>Status</th>

                                <th>Applied</th>

                            </tr>

                        </thead>

                        <tbody>

                           @foreach (var app in Model.RecentApplications)
 {<tr> 
        <td> 
      <a asp-controller="Applicant" 
       asp-action="JobDetails"
       asp-route-id="@app.JobId"> @app.JobTitle </a> 
          </td>
       <td> @app.CompanyName </td>
         <td> @app.Status </td>
        <td> @app.ApplicationDate.ToString("MMM d, yyyy") </td>  
                </tr> }
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>


    <!-- =========================================================
         JOB SEARCH SECTION
    ========================================================== -->

    <div class="card shadow-sm border-0">

        <div class="card-body">

            <div class="d-flex flex-wrap
                        justify-content-between
                        align-items-center">

                <div>

                    <h5 class="fw-bold mb-1">
                        Looking for your next opportunity?
                    </h5>

                    <p class="text-muted mb-0">
                        Explore available jobs and find opportunities
                        that match your profile.
                    </p>

                </div>

                <a asp-controller="Applicant"
                   asp-action="Jobs"
                   class="btn btn-primary mt-3 mt-md-0">

                    <i class="fa-solid fa-briefcase me-2"></i>
                    View Available Jobs

                </a>

            </div>

            </div>

    </div>

</div>


<!-- =============================================================
     OPTIONAL DASHBOARD STYLING
============================================================== -->

<style>

    .dashboard-action-card {
        transition: transform 0.2s ease,
                    box-shadow 0.2s ease;
    }

    .dashboard-action-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.10) !important;
    }

</style>

