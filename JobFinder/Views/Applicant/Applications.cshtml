@using JobFinder.Models
@using static JobFinder.Models.Enums

@model IEnumerable<Application>

@{
ViewData["Title"] = "My Applications";
}

<div class="container-fluid py-4">


<!-- Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">

    <div>
        <h2 class="fw-bold mb-1">
            My Applications
        </h2>

        <p class="text-muted mb-0">
            Track the jobs you have applied for.
        </p>
    </div>

    <a asp-controller="Applicant"
       asp-action="Jobs"
       class="btn btn-primary mt-3 mt-md-0">

        <i class="fa-solid fa-magnifying-glass me-2"></i>
        Find Jobs

    </a>

</div>


<!-- Messages -->

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show"
         role="alert">

        <i class="fa-solid fa-circle-check me-2"></i>

        @TempData["SuccessMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show"
         role="alert">

        <i class="fa-solid fa-circle-exclamation me-2"></i>

        @TempData["ErrorMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}


@if (!Model.Any())
{
    <!-- Empty State -->

    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">

            <div class="mb-3">
                <i class="fa-solid fa-file-circle-question fa-3x text-muted"></i>
            </div>

            <h4 class="fw-bold">
                No applications yet
            </h4>

            <p class="text-muted mb-4">
                You haven't applied for any jobs yet.
                Start exploring available opportunities.
            </p>

            <a asp-controller="Applicant"
               asp-action="Jobs"
               class="btn btn-primary">

                <i class="fa-solid fa-magnifying-glass me-2"></i>
                Browse Jobs

            </a>

        </div>
    </div>
}
else
{
    <!-- Applications Table -->

    <div class="card border-0 shadow-sm">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>
                            <th class="px-4 py-3">
                                Job
                            </th>

                            <th class="py-3">
                                Company
                            </th>

                            <th class="py-3">
                                Job Type
                            </th>

                            <th class="py-3">
                                Applied
                            </th>

                            <th class="py-3">
                                Status
                            </th>

                            <th class="py-3 text-end pe-4">
                                Action
                            </th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var application in Model)
                        {
                            <tr>

                                <!-- Job -->
                                <td class="px-4">

                                    <a asp-controller="Applicant"
                                       asp-action="JobDetails"
                                       asp-route-id="@application.JobId"
                                       class="fw-semibold text-decoration-none">

                                        @application.Job.Title

                                    </a>

                                    <div class="small text-muted mt-1">
                                        @application.Job.Location
                                    </div>

                                </td>


                                <!-- Company -->
                                <td>

                                    @application.Job.Employer.CompanyName

                                </td>


                                <!-- Job Type -->
                                <td>

                                    @application.Job.JobType

                                </td>


                                <!-- Application Date -->
                                <td>

                                    @application.ApplicationDate.ToString("MMM d, yyyy")

                                </td>


                                <!-- Status -->
                                <td>

                                    <span class="badge rounded-pill bg-primary">

                                        @application.Status

                                    </span>

                                </td>


                                <!-- Action -->
                                <td class="text-end pe-4">

                                    <a asp-controller="Applicant"
                                       asp-action="JobDetails"
                                       asp-route-id="@application.JobId"
                                       class="btn btn-sm btn-outline-primary">

                                        View Job

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>
}


</div>
