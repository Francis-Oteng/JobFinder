@{
    ViewBag.Title = "Manage Jobs | HireSphere";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Back to Dashboard Button -->
<div class="back-home-btn">
    <a href="/Employer/Dashboard" class="btn btn-outline-primary btn-sm shadow-sm">
        <i class="fa-solid fa-arrow-left me-2"></i> Back to Dashboard
    </a>
</div>

<!-- Header Section -->
<section class="bg-gradient text-white py-5">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center flex-wrap">
            <div>
                <h1 class="fw-bold mb-2"><i class="fa-solid fa-briefcase me-2"></i>Manage Job Postings</h1>
                <p class="lead mb-0">View, edit, and track all your job listings</p>
            </div>
            <a href="/Employer/PostJob" class="btn btn-light btn-lg fw-semibold shadow mt-3 mt-md-0">
                <i class="fa-solid fa-plus me-2"></i> Post New Job
            </a>
        </div>
    </div>
</section>

<!-- Stats Overview -->
<section class="py-4 bg-light">
    <div class="container">
        <div class="row g-3">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm text-center p-3">
                    <h3 class="fw-bold text-primary mb-0">18</h3>
                    <small class="text-muted">Total Jobs</small>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm text-center p-3">
                    <h3 class="fw-bold text-success mb-0">12</h3>
                    <small class="text-muted">Active</small>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm text-center p-3">
                    <h3 class="fw-bold text-warning mb-0">3</h3>
                    <small class="text-muted">Drafts</small>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm text-center p-3">
                    <h3 class="fw-bold text-secondary mb-0">3</h3>
                    <small class="text-muted">Closed</small>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Filter Tabs -->
<section class="py-4">
    <div class="container">
        <ul class="nav nav-pills mb-4">
            <li class="nav-item">
                <a class="nav-link active" href="#">All Jobs (18)</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#">Active (12)</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#">Drafts (3)</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#">Closed (3)</a>
            </li>
        </ul>

        <!-- Jobs Table -->
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
