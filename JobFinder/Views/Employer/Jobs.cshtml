                                <th class="ps-4">Job Title</th>
                                <th>Location</th>
                                <th>Type</th>
                                <th>Applicants</th>
                                <th>Status</th>
                                <th>Posted</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Job Row 1 -->
                            <tr>
                                <td class="ps-4">
                                    <div>
                                        <h6 class="fw-bold mb-0">Senior Software Engineer</h6>
                                        <small class="text-muted">$120k - $160k</small>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-primary">Remote</span>
                                </td>
                                <td>Full-time</td>
                                <td>
                                    <span class="badge bg-info fs-6">47</span>
                                    <small class="text-muted ms-1">applicants</small>
                                </td>
                                <td><span class="badge bg-success">Active</span></td>
                                <td class="text-muted small">Oct 10, 2025</td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-primary" title="View">
                                            <i class="fa-solid fa-eye"></i>
                                        </button>
                                        <button class="btn btn-outline-secondary" title="Edit">
                                            <i class="fa-solid fa-edit"></i>
                                        </button>
                                        <button class="btn btn-outline-danger" title="Close">
                                            <i class="fa-solid fa-times"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>

                            <!-- Job Row 2 -->
                            <tr>
                                <td class="ps-4">
                                    <div>
                                        <h6 class="fw-bold mb-0">Frontend Developer</h6>
                                        <small class="text-muted">$90k - $130k</small>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-info">Hybrid</span>
                                </td>
                                <td>Full-time</td>
                                <td>
                                    <span class="badge bg-info fs-6">32</span>
                                    <small class="text-muted ms-1">applicants</small>
                                </td>
                                <td><span class="badge bg-success">Active</span></td>
                                <td class="text-muted small">Oct 15, 2025</td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-primary" title="View">
                                            <i class="fa-solid fa-eye"></i>
                                        </button>
                                        <button class="btn btn-outline-secondary" title="Edit">
                                            <i class="fa-solid fa-edit"></i>
                                        </button>
                                        <button class="btn btn-outline-danger" title="Close">
                                            <i class="fa-solid fa-times"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>

                            <!-- Job Row 3 -->
                            <tr>
                                <td class="ps-4">
                                    <div>
                                        <h6 class="fw-bold mb-0">Product Manager</h6>
                                        <small class="text-muted">$110k - $150k</small>
                                    </div>
                                </td>
                                <td>New York, NY</td>
                                <td>Full-time</td>
                                <td>
                                    <span class="badge bg-info fs-6">28</span>
                                    <small class="text-muted ms-1">applicants</small>
                                </td>
                                <td><span class="badge bg-success">Active</span></td>
                                <td class="text-muted small">Oct 12, 2025</td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-primary" title="View">
                                            <i class="fa-solid fa-eye"></i>
                                        </button>
                                        <button class="btn btn-outline-secondary" title="Edit">
                                            <i class="fa-solid fa-edit"></i>
                                        </button>
                                        <button class="btn btn-outline-danger" title="Close">
                                            <i class="fa-solid fa-times"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>

                            <!-- Job Row 4 (Draft) -->
                            <tr class="table-warning">
                                <td class="ps-4">
                                    <div>
                                        <h6 class="fw-bold mb-0">UX Designer</h6>
