@model JobFinder.Models.ViewModels.EmployerDashboardViewModel

@{
    ViewData["Title"] = "Employer Dashboard";
}

@if (TempData["Success"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] is string errorMessage)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @errorMessage
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close"></button>
    </div>
}

<!-- Dashboard Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0">
            @Model.CompanyName

            @if (Model.IsVerified)
            {
                <span class="badge bg-success ms-2">
                    Verified
                </span>
            }
            else
            {
                <span class="badge bg-secondary ms-2">
                    Unverified
                </span>
            }
        </h2>
    </div>

    <a asp-controller="Employer"
       asp-action="PostJob"
       class="btn btn-primary">
        <i class="fa-solid fa-plus me-1"></i>
        Post a job
    </a>
</div>


<!-- Statistics -->
<div class="row g-3 mb-4">

    <!-- Active Jobs -->
    <div class="col-6 col-md-3">
        <div class="card text-center shadow-sm h-100">
            <div class="card-body">
                <div class="fs-3 fw-bold">
                    @Model.ActiveJobsCount
                </div>

                <div class="text-muted small">
                    Active jobs
                </div>
            </div>
        </div>
    </div>

    <!-- Draft Jobs -->
    <div class="col-6 col-md-3">
        <div class="card text-center shadow-sm h-100">
            <div class="card-body">
                <div class="fs-3 fw-bold">
                    @Model.DraftJobsCount
                </div>

                <div class="text-muted small">
                    Drafts
                </div>
            </div>
        </div>
    </div>

    <!-- Total Applicants -->
    <div class="col-6 col-md-3">
        <div class="card text-center shadow-sm h-100">
            <div class="card-body">
                <div class="fs-3 fw-bold">
                    @Model.TotalApplicantsCount
                </div>

                <div class="text-muted small">
                    Total applicants
                </div>
            </div>
        </div>
    </div>

    <!-- Shortlisted -->
    <div class="col-6 col-md-3">
        <div class="card text-center shadow-sm h-100">
            <div class="card-body">
                <div class="fs-3 fw-bold">
                    @Model.ShortlistedCount
                </div>

                <div class="text-muted small">
                    Shortlisted
                </div>
            </div>
        </div>
    </div>

    <!-- Interviews -->
    <div class="col-6 col-md-3">
        <div class="card text-center shadow-sm h-100">
            <div class="card-body">
                <div class="fs-3 fw-bold">
                    @Model.InterviewCount
                </div>

                <div class="text-muted small">
                    In interviews
                </div>
            </div>
        </div>
    </div>

</div>


<!-- Recent Job Postings -->
<div class="card shadow-sm">

    <!-- Card Header -->
    <div class="card-header d-flex justify-content-between align-items-center">

        <span class="fw-semibold">
            Recent job postings
        </span>

        <a asp-controller="Employer"
           asp-action="Jobs"
           class="btn btn-link text-decoration-none">

            View All

            <i class="fa-solid fa-arrow-right ms-1"></i>
        </a>

    </div>


    <!-- Card Body -->
    <div class="card-body p-0">

        @if (!Model.RecentJobs.Any())
        {
            <div class="p-4 text-center">

                <i class="fa-solid fa-briefcase fs-2 text-muted mb-3"></i>

                <p class="text-muted mb-3">
                    You haven't posted any jobs yet.
                </p>

                <a asp-controller="Employer"
                   asp-action="PostJob"
                   class="btn btn-primary">

                    <i class="fa-solid fa-plus me-1"></i>
                    Post your first job

                </a>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th>
                                Title
                            </th>

                            <th>
                                Status
                            </th>

                            <th>
                                Applicants
                            </th>

                            <th>
                                Posted
                            </th>

                            <th class="text-end">
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var job in Model.RecentJobs)
                        {
                            <tr>

                                <!-- Job Title -->
                                <td>

                                    <div class="fw-semibold">
                                        @job.Title
                                    </div>

                                </td>


                                <!-- Status -->
                                <td>

                                    @if (job.Status.ToString() == "Active")
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    }
                                    else if (job.Status.ToString() == "Draft")
                                    {
                                        <span class="badge bg-secondary">
                                            Draft
                                        </span>
                                    }
                                    else if (job.Status.ToString() == "Closed")
                                    {
                                        <span class="badge bg-dark">
                                            Closed
                                        </span>
                                    }
                                    else if (job.Status.ToString() == "Expired")
                                    {
                                        <span class="badge bg-danger">
                                            Expired
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @job.Status
                                        </span>
                                    }

                                </td>


                                <!-- Applicants -->
                                <td>

                                    <span class="fw-semibold">
                                        @job.ApplicationsCount
                                    </span>

                                </td>


                                <!-- Posted Date -->
                                <td>

                                    <span class="text-muted">
                                        @job.PostedDate.ToString("MMM d, yyyy")
                                    </span>

                                </td>


                                <!-- Actions -->
                                <td>

                                    <div class="d-flex justify-content-end gap-2 flex-wrap">

                                        <!-- View Job -->
                                        <a asp-controller="Employer"
                                           asp-action="JobDetails"
                                           asp-route-id="@job.JobId"
                                           class="btn btn-sm btn-outline-secondary"
                                           title="View job">

                                            <i class="fa-solid fa-eye me-1"></i>
                                            View

                                        </a>


                                        <!-- View Applicants -->
                                        <a asp-controller="Employer"
                                           asp-action="JobApplicants"
                                           asp-route-id="@job.JobId"
                                           class="btn btn-sm btn-outline-primary"
                                           title="View applicants">

                                            <i class="fa-solid fa-users me-1"></i>
                                            Applicants

                                        </a>


                                        <!-- Edit Job -->
                                        <a asp-controller="Employer"
                                           asp-action="EditJob"
                                           asp-route-id="@job.JobId"
                                           class="btn btn-sm btn-primary"
                                           title="Edit job">

                                            <i class="fa-solid fa-pen-to-square me-1"></i>
                                            Edit

                                        </a>


                                        <!-- Delete Job -->
                                        <a asp-controller="Employer"
                                           asp-action="DeleteJob"
                                           asp-route-id="@job.JobId"
                                           class="btn btn-sm btn-outline-danger"
                                           title="Delete job">

                                            <i class="fa-solid fa-trash me-1"></i>
                                            Delete

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>