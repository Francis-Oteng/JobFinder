@model JobFinder.Models.ViewModels.EmployerDashboardViewModel
@{
    ViewData["Title"] = "Employer Dashboard";
}
@if (TempData["Success"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0">
            @Model.CompanyName
            @if (Model.IsVerified)
            {
                <span class="badge bg-success ms-2">Verified</span>
            }
            else
            {
                <span class="badge bg-secondary ms-2">Unverified</span>
            }
        </h2>
    </div>
    <a asp-controller="Employer" asp-action="PostJob" class="btn btn-primary">+ Post a job</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card text-center shadow-sm">
            <div class="card-body">
                <div class="fs-3 fw-bold">@Model.ActiveJobsCount</div>
                <div class="text-muted small">Active jobs</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center shadow-sm">
            <div class="card-body">
                <div class="fs-3 fw-bold">@Model.DraftJobsCount</div>
                <div class="text-muted small">Drafts</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center shadow-sm">
            <div class="card-body">
                <div class="fs-3 fw-bold">@Model.TotalApplicantsCount</div>
                <div class="text-muted small">Total applicants</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center shadow-sm">
            <div class="card-body">
                <div class="fs-3 fw-bold">@Model.ShortlistedCount</div>
                <div class="text-muted small">Shortlisted</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center shadow-sm">
            <div class="card-body">
                <div class="fs-3 fw-bold">@Model.InterviewCount</div>
                <div class="text-muted small">In interviews</div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Recent job postings</span>
        <a asp-controller="Employer" asp-action="Jobs" class="small">View all</a>
    </div>
    <div class="card-body p-0">
        @if (!Model.RecentJobs.Any())
        {
            <p class="text-muted p-3 mb-0">You haven't posted any jobs yet.</p>
        }
        else
        {
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Status</th>
                        <th>Applicants</th>
                        <th>Posted</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var job in Model.RecentJobs)
                    {
                        <tr>
                            <td>@job.Title</td>
                            <td><span class="badge bg-secondary">@job.Status</span></td>
                            <td>@job.ApplicationsCount</td>
                            <td>@job.PostedDate.ToString("MMM d, yyyy")</td>
                            <td>
                                <a asp-controller="Employer" asp-action="JobApplicants"
                                   asp-route-id="@job.JobId" class="small">Applicants</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
