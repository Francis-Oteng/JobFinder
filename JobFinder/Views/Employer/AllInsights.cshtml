@{
    ViewBag.Title = "AI Insights | HireSphere";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Back to Dashboard Button -->
<div class="back-home-btn">
    <a href="/Employer/Dashboard" class="btn btn-outline-primary btn-sm shadow-sm">
        <i class="fa-solid fa-arrow-left me-2"></i> Back to Dashboard
    </a>
</div>

<!-- Header Section -->
<section class="bg-gradient text-white py-5">
    <div class="container">
        <h1 class="fw-bold mb-2"><i class="fa-solid fa-robot me-2"></i>AI Insights & Recommendations</h1>
        <p class="lead mb-0">Data-driven insights to optimize your hiring process</p>
        <small class="text-white-50">Last updated: @DateTime.Now.ToString("MMM dd, yyyy hh:mm tt")</small>
    </div>
</section>

<!-- Key Metrics -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="fw-bold mb-0">Performance Overview</h3>
            <div class="btn-group" role="group">
                <button type="button" class="btn btn-sm btn-outline-primary active" data-period="week">This Week</button>
                <button type="button" class="btn btn-sm btn-outline-primary" data-period="month">This Month</button>
                <button type="button" class="btn btn-sm btn-outline-primary" data-period="year">This Year</button>
            </div>
        </div>
        <div class="row g-4">
            <div class="col-md-3">
                <div class="card metric-card border-0 shadow-sm text-center p-4">
                    <i class="fa-solid fa-chart-line fa-3x text-primary mb-3"></i>
                    <h4 class="fw-bold text-primary counter" data-target="87">0%</h4>
                    <p class="text-muted mb-0">Hiring Success Rate</p>
                    <small class="text-success"><i class="fa-solid fa-arrow-up"></i> +12% from last month</small>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card metric-card border-0 shadow-sm text-center p-4">
                    <i class="fa-solid fa-clock fa-3x text-success mb-3"></i>
                    <h4 class="fw-bold text-success counter" data-target="14">0 days</h4>
                    <p class="text-muted mb-0">Avg. Time to Hire</p>
                    <small class="text-success"><i class="fa-solid fa-arrow-down"></i> -3 days improvement</small>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card metric-card border-0 shadow-sm text-center p-4">
                    <i class="fa-solid fa-users fa-3x text-warning mb-3"></i>
                    <h4 class="fw-bold text-warning counter" data-target="92">0%</h4>
                    <p class="text-muted mb-0">Candidate Quality Score</p>
                    <small class="text-success"><i class="fa-solid fa-arrow-up"></i> +8% improvement</small>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card metric-card border-0 shadow-sm text-center p-4">
                    <i class="fa-solid fa-star fa-3x text-info mb-3"></i>
                    <h4 class="fw-bold text-info">4.8/5</h4>
                    <p class="text-muted mb-0">Employer Rating</p>
                    <small class="text-success">Excellent</small>
                </div>
            </div>
        </div>
    </div>
</section>

