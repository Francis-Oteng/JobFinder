@{
    ViewBag.Title = "Messages | HireSphere";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="back-home-btn">
    <a href="/Employer/Dashboard" class="btn btn-outline-primary btn-sm shadow-sm">
        <i class="fa-solid fa-arrow-left me-2"></i> Back to Dashboard
    </a>
</div>

<section class="bg-gradient text-white py-5">
    <div class="container">
        <h1 class="fw-bold mb-2"><i class="fa-solid fa-envelope me-2"></i>Messages</h1>
        <p class="lead mb-0">Communicate with applicants</p>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="row">
            <!-- Conversations List -->
            <div class="col-md-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-0">
                        <div class="p-3 border-bottom">
                            <input type="text" class="form-control" placeholder="Search messages...">
                        </div>
                        <div class="list-group list-group-flush">
                            <a href="#" class="list-group-item list-group-item-action active">
                                <div class="d-flex w-100 justify-content-between">
                                    <h6 class="mb-1 fw-bold">Sarah Johnson</h6>
                                    <small>2h ago</small>
                                </div>
                                <p class="mb-1 small">Thank you for considering my application...</p>
                                <span class="badge bg-primary">2 new</span>
                            </a>
                            <a href="#" class="list-group-item list-group-item-action">
                                <div class="d-flex w-100 justify-content-between">
                                    <h6 class="mb-1 fw-bold">Michael Chen</h6>
                                    <small>1d ago</small>
                                </div>
                                <p class="mb-1 small">I'm available for an interview next week...</p>
                            </a>
                            <a href="#" class="list-group-item list-group-item-action">
                                <div class="d-flex w-100 justify-content-between">
                                    <h6 class="mb-1 fw-bold">Emily Rodriguez</h6>
                                    <small>3d ago</small>
                                </div>
                                <p class="mb-1 small">Could you provide more details about...</p>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Chat Window -->
            <div class="col-md-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <div class="d-flex align-items-center">
                            <img src="https://via.placeholder.com/40" class="rounded-circle me-2" alt="User">
                            <div>
                                <h6 class="mb-0 fw-bold">Sarah Johnson</h6>
                                <small>Senior Developer</small>
                            </div>
                        </div>
                    </div>
                    <div class="card-body" style="height: 400px; overflow-y: auto;">
                        <!-- Message 1 (Received) -->
                        <div class="mb-3">
                            <div class="d-flex">
                                <img src="https://via.placeholder.com/30" class="rounded-circle me-2" alt="User" style="width: 30px; height: 30px;">
                                <div>
                                    <div class="bg-light p-3 rounded">
                                        <p class="mb-0">Hi! Thank you for considering my application for the Senior Software Engineer position.</p>
                                    </div>
                                    <small class="text-muted">2 hours ago</small>
                                </div>
                            </div>
                        </div>

                        <!-- Message 2 (Sent) -->
                        <div class="mb-3">
                            <div class="d-flex justify-content-end">
                                <div class="text-end">
                                    <div class="bg-primary text-white p-3 rounded">
                                        <p class="mb-0">Hello Sarah! We're impressed with your profile. Would you be available for an interview next week?</p>
                                    </div>
                                    <small class="text-muted">1 hour ago</small>
                                </div>
                            </div>
                        </div>

                        <!-- Message 3 (Received) -->
                        <div class="mb-3">
                            <div class="d-flex">
                                <img src="https://via.placeholder.com/30" class="rounded-circle me-2" alt="User" style="width: 30px; height: 30px;">
                                <div>
                                    <div class="bg-light p-3 rounded">
                                        <p class="mb-0">Yes, I'm available! Tuesday or Wednesday would work best for me.</p>
                                    </div>
                                    <small class="text-muted">30 minutes ago</small>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer">
                        <form class="d-flex gap-2">
                            <input type="text" class="form-control" placeholder="Type your message...">
                            <button type="submit" class="btn btn-primary">
                                <i class="fa-solid fa-paper-plane"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
.back-home-btn {
    position: fixed;
    top: 80px;
    left: 20px;
    z-index: 1000;
    opacity: 1;
    transition: opacity 0.3s ease;
}
.back-home-btn.fade-out {
    opacity: 0;
    pointer-events: none;
}
.bg-gradient {
    background: linear-gradient(135deg, #2563eb 0%, #22c1c3 100%);
}
</style>

<script>
    // Fade out back button on scroll
    window.addEventListener('scroll', function() {
        const backBtn = document.querySelector('.back-home-btn');
        const scrollPosition = window.scrollY;
        
        // Start fading after 100px scroll
        if (scrollPosition > 100) {
            backBtn.classList.add('fade-out');
        } else {
            backBtn.classList.remove('fade-out');
        }
    });
</script>
