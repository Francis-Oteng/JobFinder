@model JobFinder.Models.ViewModels.PostJobViewModel
@{
    ViewData["Title"] = "Post a Job";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Post a job</h2>
    <a asp-controller="Employer" asp-action="Dashboard" class="btn btn-outline-secondary">Back to dashboard</a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-4">
        <form asp-controller="Employer" asp-action="PostJob" method="post">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" placeholder="e.g. Senior Backend Engineer" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Location" class="form-label"></label>
                    <input asp-for="Location" class="form-control" placeholder="e.g. Kumasi, Ghana" />
                    <span asp-validation-for="Location" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Category" class="form-label"></label>
                    <input asp-for="Category" class="form-control" placeholder="e.g. Engineering" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="JobType" class="form-label"></label>
                    <select asp-for="JobType" asp-items="Model.JobTypeOptions" class="form-select"></select>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="WorkArrangement" class="form-label"></label>
                    <select asp-for="WorkArrangement" asp-items="Model.WorkArrangementOptions" class="form-select"></select>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="ExperienceLevel" class="form-label"></label>
                    <select asp-for="ExperienceLevel" asp-items="Model.ExperienceLevelOptions" class="form-select"></select>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4"
                          placeholder="What the role involves day to day"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Requirements" class="form-label"></label>
                <textarea asp-for="Requirements" class="form-control" rows="4"
                          placeholder="Must-have qualifications"></textarea>
                <span asp-validation-for="Requirements" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Responsibilities" class="form-label"></label>
                <textarea asp-for="Responsibilities" class="form-control" rows="3"></textarea>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="RequiredSkills" class="form-label"></label>
                    <input asp-for="RequiredSkills" class="form-control" placeholder="Comma-separated, e.g. C#, SQL, Azure" />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Education" class="form-label"></label>
                    <input asp-for="Education" class="form-control" />
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Benefits" class="form-label"></label>
                <textarea asp-for="Benefits" class="form-control" rows="3"></textarea>
            </div>

            <div class="row">
                <div class="col-md-3 mb-3">
                    <label asp-for="ExperienceYears" class="form-label"></label>
                    <input asp-for="ExperienceYears" class="form-control" type="number" min="0" max="60" />
                    <span asp-validation-for="ExperienceYears" class="text-danger"></span>
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="SalaryMin" class="form-label"></label>
                    <input asp-for="SalaryMin" class="form-control" type="number" step="0.01" min="0" />
                    <span asp-validation-for="SalaryMin" class="text-danger"></span>
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="SalaryMax" class="form-label"></label>
                    <input asp-for="SalaryMax" class="form-control" type="number" step="0.01" min="0" />
                    <span asp-validation-for="SalaryMax" class="text-danger"></span>
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="ClosingDate" class="form-label"></label>
                    <input asp-for="ClosingDate" class="form-control" type="date" />
                    <span asp-validation-for="ClosingDate" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" asp-items="Model.StatusOptions" class="form-select" style="max-width: 250px;"></select>
                <span asp-validation-for="Status" class="text-danger"></span>
                <div class="form-text">Draft is only visible to you. Active is live on the job board.</div>
            </div>

            <button type="submit" class="btn btn-primary">Save job</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
