@{
    ViewBag.Title = "Login | HireSphere";
    Layout = "~/Views/Shared/_SignInLayout.cshtml";
}

<!-- ===== MAIN LOGIN SECTION ===== -->
<div class="d-flex justify-content-center align-items-center vh-100 bg-gradient position-relative">
    <div class="card shadow-lg border-0 rounded-4" style="width: 400px; background: rgba(255,255,255,0.9);">
        <div class="card-body p-4 text-center">
            <h3 class="fw-bold text-primary mb-2">Welcome Back 👋</h3>
            <p class="text-muted mb-4">Log in to continue your HireSphere journey</p>

            <form method="post" action="/Account/Login">
            @Html.AntiForgeryToken()
                <div class="form-group text-start mb-3">
                    <label class="form-label fw-semibold">Email address</label>
                    <input type="email" name="email" class="form-control" placeholder="you@example.com" required />
                </div>

<div class="form-group text-start mb-3">
                    <label class="form-label fw-semibold">Password</label>
                    <div class="input-group">
                        <input type="password" name="password" id="loginPassword" class="form-control" placeholder="Enter password" required />
                        <button class="btn btn-outline-secondary" type="button" id="toggleLoginPassword">Show</button>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <input type="checkbox" name="remember" /> Remember me
                    </div>
                    <a href="/Account/ForgotPassword" class="text-decoration-none small text-primary">Forgot password?</a>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fa-solid fa-exclamation-circle me-2"></i>@ViewBag.Error
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <button type="submit" class="btn btn-primary w-100 fw-semibold">Login</button>
            </form>

            <div class="mt-3">
                <p class="small">New to HireSphere? <a href="/Account/Register?role=@Context.Request.Query["role"]" class="text-decoration-none text-primary">Create an Account</a></p>
            </div>
        </div>
    </div>

    <!-- Floating Assistant -->
    <div class="ai-assistant" id="aiAssistant" title="Click to view help">
        <div class="speech-bubble">
            Hi, I'm <strong>Sphere 🤖</strong><br />
            Here to help you log in!
        </div>
    </div>
</div>

<!-- ===== MODAL MANUAL ===== -->
<div class="modal fade" id="aiHelpModal" tabindex="-1" aria-labelledby="aiHelpModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg border-0 rounded-4">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="aiHelpModalLabel">
                    <i class="fa-solid fa-robot me-2"></i> Login & Registration Help
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <h6 class="fw-bold text-primary mb-3">How to Register or Login</h6>
                <ul class="list-group list-group-flush small">
                    <li class="list-group-item">
                        <strong>1️⃣ New to HireSphere?</strong><br />
                        Click <b>Register</b> at the top or below the login form. Fill in your name, email, password, and select your role.
                    </li>
                    <li class="list-group-item">
                        <strong>2️⃣ Already registered?</strong><br />
                        Use your registered <b>email</b> and <b>password</b> to log in.
                    </li>
                    <li class="list-group-item">
                        <strong>3️⃣ Forgot password?</strong><br />
                        Use the <i>“Forgot Password”</i> link to reset your credentials via email.
                    </li>
                    <li class="list-group-item">
                        <strong>4️⃣ Tips:</strong><br />
                        • Ensure your email is correct.<br />
                        • Password must be 8+ characters.<br />
                        • Choose your role carefully (Applicant or Employer).
                    </li>
                </ul>

                <div class="text-center mt-4">
                    <img src="https://cdn.dribbble.com/users/209558/screenshots/15428278/media/ed09b773c511ae6efc0b2dfc729e0171.gif"
                         alt="AI Assistant"
                         class="img-fluid rounded-3 shadow-sm"
                         style="max-height:180px;">
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary fw-semibold" data-bs-dismiss="modal">Got it 👍</button>
            </div>
        </div>
    </div>
</div>

<!-- ===== STYLE & SCRIPT ===== -->
@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", () => {
        const aiAssistant = document.getElementById("aiAssistant");
        aiAssistant.addEventListener("click", () => {
            const modal = new bootstrap.Modal(document.getElementById("aiHelpModal"));
            modal.show();
        });

        // Password toggle
        const password = document.getElementById("loginPassword");
        const toggle = document.getElementById("toggleLoginPassword");

        toggle.addEventListener("click", () => {
            if (password.type === "password") {
                password.type = "text";
                toggle.textContent = "Hide";
            } else {
                password.type = "password";
                toggle.textContent = "Show";
            }
        });
    });
</script>

<style>
    .bg-gradient {
        background: linear-gradient(135deg, #2563eb, #22c1c3);
    }

    .ai-assistant {
        position: fixed;
        bottom: 20px;
        right: 20px;
        cursor: pointer;
        z-index: 1050;
        animation: floaty 3s ease-in-out infinite;
    }

    .speech-bubble {
        background-color: #2563eb;
        color: white;
        padding: 15px 18px;
        border-radius: 18px;
        font-size: 14px;
        box-shadow: 0 8px 18px rgba(0,0,0,0.2);
        transition: all 0.3s ease;
    }

    .speech-bubble:hover {
        background-color: #1d4ed8;
        transform: scale(1.05);
    }

    @@keyframes floaty {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-6px); }
    }
</style>
}
